# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

eval "$(starship init bash)"

# Basic Aliases & Functions
alias ls='lsd'
alias grep='grep --color=auto'
alias clr='clear'
alias x='exit'
alias shutdown='sudo shutdown'

fuckyou()
{
	echo "Ask politely next time!"
	sudo bash -c "$(fc -ln -2)"
}

goodnight()
{
	echo "Goodnight, $USER!"
	sleep 3
	sudo systemctl suspend
}

goodbye()
{
	echo "Goodbye for now, $USER!"
	sleep 3
	sudo shutdown now
}

md() {
    mkdir -p "$1" && cd "$1" || return
}

up() {
    local d=""
    local limit="${1:-1}"
    for ((i=1; i <= limit; i++)); do
        d="../$d"
    done
    cd "$d" || return
}

eval "$(zoxide init bash)"

# yazi: cd into the folder you were last in when you quit
y() {
    local tmp cwd
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    command yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
}

i() {
    for pkg in "$@"; do
        if pacman -Si "$pkg" &>/dev/null; then
            sudo pacman -S "$pkg"
        else
          paru -S "$pkg"
        fi
    done
}

update()
{ 
    paru -Syu
}

export EDITOR="nano"
export VISUAL="nano"

# LABYRINTH-PROMPT
[ -f "$HOME/.config/labyrinth/prompt.bash" ] && source "$HOME/.config/labyrinth/prompt.bash"
