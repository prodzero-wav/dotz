# LABYRINTH v2: SwayFX
set $mod Mod4
set $term foot
set $menu fuzzel
set $browser firefox
set $browser_id firefox
set $files foot yazi

# palette (pulled from the painting)
set $bg    #060b09
set $green #1f3a31
set $teal  #6f9f8b
set $bone  #d4cba8
set $dim   #8f8a6e
set $rust  #b5523b

font pango:UnifontExMono 12
xwayland enable
output * bg ~/Pictures/wallpapers/labyrinth.jpg fill
seat * hide_cursor 5000
focus_follows_mouse yes

input type:keyboard {
    xkb_layout gb
}
input type:touchpad {
    tap enabled
    dwt enabled
}

# ---------- look ----------
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart
gaps inner 14
gaps outer 6

client.focused          $bone99  $bg66 $bone $bone99  $bone99
client.focused_inactive $bone33  $bg66 $dim  $bone33  $bone33
client.unfocused        $bone22  $bg66 $dim  $bone22  $bone22
client.urgent           $rust  $bg $rust $rust  $rust
client.background       $bg

# ---------- SwayFX ----------
corner_radius 14
blur enable
blur_xray disable
blur_passes 4
blur_radius 9
blur_noise 0.02
blur_brightness 0.9
blur_contrast 0.95
blur_saturation 1.25

# focused window glows teal, the rest sink into black
shadows enable
shadow_blur_radius 40
shadow_offset 0 0
shadow_color #6f9f8b66
shadow_inactive_color #000000cc

default_dim_inactive 0.15
dim_inactive_colors.unfocused #000000ff

layer_effects "waybar" blur enable; blur_ignore_transparent disable; shadows disable; corner_radius 14
layer_effects "launcher" blur enable; blur_ignore_transparent enable; shadows enable; corner_radius 16
layer_effects "notifications" blur enable; blur_ignore_transparent enable; shadows disable

# ---------- window rules that depend on the look (rewritten by theme-apply.py) ----------
for_window [app_id="^(?!foot|dropdown|mazesaver|shutdown|music).*"] opacity 0.92
for_window [app_id="firefox"] opacity 0.88
animation_duration_ms 200
seat * hide_cursor when-typing enable
seat seat0 xcursor_theme Hackneyed 24

# ---------- split config ----------
# binds, rules and startup live in conf.d/ (keys.sh reads them too)
include ~/.config/sway/conf.d/*.conf
include /etc/sway/config.d/*

# per-machine settings (monitor mode, etc.) go in ~/.config/sway/local.d/*.conf, not tracked
# (included last so it can override anything above)
include ~/.config/sway/local.d/*
